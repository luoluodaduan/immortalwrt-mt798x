	default BUSYBOX_DEFAULT_FEATURE_WGET_OPENSSL
	depends on BUSYBOX_CONFIG_WGET

config BUSYBOX_CONFIG_WHOIS
	bool "whois (6.3 kb)"
	default BUSYBOX_DEFAULT_WHOIS

config BUSYBOX_CONFIG_ZCIP
	bool "zcip (8.4 kb)"
	default BUSYBOX_DEFAULT_ZCIP
